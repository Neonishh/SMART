NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

PORT=5000

# Short-term gate on the manual-entry submission form, until real
# auth (Login) is wired up. Leave unset locally if you don't need it.
CONTRIBUTOR_ACCESS_CODE=

# ----------------------------------------------------------
# Ask SMART chatbot
# ----------------------------------------------------------

# LLM used to write natural-language answers.
#   openai -> any OpenAI-compatible API. Default setup is Groq (free key:
#             https://console.groq.com/keys). Also works with OpenAI,
#             OpenRouter or a local Ollama by changing OPENAI_BASE_URL.
#   gemini -> Google Gemini, needs GEMINI_API_KEY (https://aistudio.google.com/apikey)
#   none   -> no LLM; the chatbot answers with formatted facts + sources
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# Groq model id. llama-3.3-70b-versatile has been retired; list the models
# your key can use with GET https://api.groq.com/openai/v1/models
LLM_MODEL=openai/gpt-oss-120b

# Only for LLM_PROVIDER=gemini
GEMINI_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_MS=45000
# Optional, reasoning models only (low | medium | high). Defaults to "low" for
# gpt-oss models so answers stay inside free-tier tokens-per-minute limits.
LLM_REASONING_EFFORT=

# Python FAISS retriever (python_retriever/app.py)
RETRIEVER_URL=http://localhost:8001
RETRIEVER_ENABLED=true
RETRIEVER_TIMEOUT_MS=8000

# Log classifier output for every chat message
CHAT_DEBUG=false
