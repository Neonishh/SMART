NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

PORT=5000

# Short-term gate on the manual-entry submission form, until real
# auth (Login) is wired up. Leave unset locally if you don't need it.
CONTRIBUTOR_ACCESS_CODE=

# ----------------------------------------------------------
# Ask SMART chatbot
# ----------------------------------------------------------

# LLM used to write natural-language answers.
#   gemini -> needs GEMINI_API_KEY (free key: https://aistudio.google.com/apikey)
#   openai -> any OpenAI-compatible API (OpenAI, Groq, OpenRouter, local Ollama)
#   none   -> no LLM; the chatbot answers with formatted facts + sources
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: pin a model (default: gemini-flash-latest / gpt-4o-mini)
LLM_MODEL=

# For LLM_PROVIDER=openai
OPENAI_API_KEY=
# e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1 (Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_MS=45000
# Optional, reasoning models only (low | medium | high). Defaults to "low" for
# gpt-oss models so answers stay inside free-tier tokens-per-minute limits.
LLM_REASONING_EFFORT=

# Python FAISS retriever (python_retriever/app.py)
RETRIEVER_URL=http://localhost:8001
RETRIEVER_ENABLED=true
RETRIEVER_TIMEOUT_MS=8000

# Log classifier output for every chat message
CHAT_DEBUG=false
